[Unit]
Description=Chimera file index (Everything-style live search)
After=local-fs.target

[Service]
ExecStart=/usr/bin/chimera-indexd
Restart=on-failure
RuntimeDirectory=chimera
RuntimeDirectoryMode=0755
# index snapshot (lists every filename): root-only
StateDirectory=chimera
StateDirectoryMode=0700
Nice=10
IOSchedulingClass=idle
# read-only view of the system; it only needs to stat and watch
ProtectSystem=strict
ProtectHome=read-only
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
