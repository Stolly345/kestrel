# Maintainer: Stolly345 <114888417+Stolly345@users.noreply.github.com>
# Repackages the release .deb (the same binaries as the .deb/.rpm; built on Ubuntu 26.04).
# New release: set pkgver, sha256sum of the uploaded .deb, then `makepkg --printsrcinfo > .SRCINFO`.
pkgname=kestrel-bin
pkgver=0.9.37
pkgrel=1
pkgdesc="File manager with instant whole-disk search (Everything + Files for Linux)"
arch=('x86_64')
url="https://github.com/Stolly345/kestrel"
license=('MIT OR Apache-2.0')
depends=('gtk4' 'libadwaita' 'vte4' 'gstreamer' 'glib2' 'gdk-pixbuf2' 'graphene' 'pango' 'zlib' 'glibc' 'libgcc'
         'bubblewrap' 'tar' 'gzip' 'xz' 'bzip2' 'zstd' 'gvfs' 'xdg-utils' 'polkit' 'curl')
optdepends=('gst-plugins-good: more audio/video formats in the preview'
            'gst-plugins-bad: more audio/video formats in the preview'
            'gst-plugins-ugly: more audio/video formats in the preview'
            'gst-libav: more audio/video formats in the preview'
            'gvfs-smb: Windows shares on the Network page'
            'cifs-utils: Index… on the Network page (search a NAS)'
            'xdg-terminal-exec: Open in Terminal uses your chosen terminal'
            'poppler: PDF page previews'
            'libreoffice-fresh: previews of Office documents')
provides=('kestrel')
conflicts=('kestrel')
backup=('etc/kestrel/excludes')
install=kestrel-bin.install
# prebuilt, already stripped release binaries
options=('!debug' '!strip')
source=("https://github.com/Stolly345/kestrel/releases/download/v${pkgver}/kestrel_${pkgver}-1_amd64.deb")
sha256sums=('4692aee7d407ccaf96647c61f746841f6ec5d86d37a8151a8d0ea7dd63be389a')

package() {
    bsdtar -xf data.tar.* -C "$pkgdir"
    # Arch keeps licences in /usr/share/licenses and has no use for Debian's copyright file
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    mv "$pkgdir"/usr/share/doc/kestrel/{LICENSE-MIT,LICENSE-APACHE,THIRD-PARTY-LICENSES.txt,7zip-License.txt} \
        "$pkgdir/usr/share/licenses/$pkgname/"
    rm -f "$pkgdir/usr/share/doc/kestrel/copyright"
}
