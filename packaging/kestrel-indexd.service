[Unit]
Description=Kestrel file index (Everything-style live search)
After=local-fs.target

[Service]
ExecStart=/usr/bin/kestrel-indexd
Restart=on-failure
RuntimeDirectory=kestrel
RuntimeDirectoryMode=0755
# index snapshot (lists every filename): root-only
StateDirectory=kestrel
StateDirectoryMode=0700
Nice=10
IOSchedulingClass=idle
# read-only view of the system; it only needs to stat and watch
ProtectSystem=strict
ProtectHome=read-only
PrivateNetwork=yes
NoNewPrivileges=yes
# SYS_ADMIN: fanotify on whole file systems; DAC_READ_SEARCH: scan and open by handle;
# SETUID/SETGID: `content:` opens files with the asking user's fsuid/groups (kernel-checked)
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID
# any local user can query: bound what a flood of requests could cost
MemoryHigh=1G
MemoryMax=3G
TasksMax=256
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
